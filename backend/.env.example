# Renombra este archivo a .env y completa con tus propios datos.

DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/molinos_db

# Clave usada para firmar los tokens de sesión (JWT) — genera una propia,
# no reutilices ningún valor de ejemplo.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Ruta al ejecutable de Tesseract OCR (usado para leer datos desde imágenes).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# URL donde corre el frontend — la usa el backend para generar los PDF.
FRONTEND_URL=http://localhost:4200

# ── Envío automático de PDF de exportación (opcional) ───────────────────────
# Si se deja vacío, el programa sigue funcionando igual — solo no envía los
# PDF automáticamente a ningún lado.

# Opción A: un flujo de n8n (o similar) que reciba el PDF y lo suba a su
# destino final.
N8N_WEBHOOK_URL=

# Opción B: envío por correo (se usa solo si N8N_WEBHOOK_URL está vacío).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_EXPORTACION_DESTINO=
